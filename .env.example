# Every variable the containers and the backend read (implementation 08, Phase 3).
# Copy to `.env` beside compose.yaml and fill only what you need: an empty value means the default
# written after it. `.env` is ignored by git. A variable exported in your shell wins over this file.

# --- Hugging Face (the MuScriptor weights are gated) ---------------------------------------------
# A read token of the account that accepted the MuScriptor licence. No default. On the Ubuntu
# machine it is already exported in ~/.zshrc, so it can stay empty here.
HF_TOKEN=
# The host folder of the Hugging Face hub cache, mounted at /hf/hub. Default /mnt/ssd2/hf/data/hub.
HF_HUB_CACHE=

# --- Claude (the LLM step of the new sheet, implementation 03, Phase 4) --------------------------
# An API key of the Claude Console organization linked to the Max 5x credits (100 USD a month).
# No default: without it the sheet stays the algorithm's. Never commit it.
ANTHROPIC_API_KEY=

# --- The backend (aitu_backend/config.py) --------------------------------------------------------
# `.database/`: every record and every file of the app (implementation 02, plan section 8).
# Empty: `.database` at the root of the repository. On the Ubuntu machine set this to
# /mnt/ssd2/aimpromptu/.database and do not link that folder into the repository.
# With compose: this host folder is mounted at /database.
AITU_DATABASE_DIR=
# The username of the master user, made on the first start when the database has none.
# Default master.
AITU_MASTER_USERNAME=
# cpu, cuda or auto. Natively the default is cpu; compose.yaml sets cuda.
AITU_DEVICE=
# MuScriptor's size (small, medium, large) and weight type (float32, float16, bfloat16).
# Default large and float16, the choice of Phase 1.
AITU_MUSCRIPTOR_MODEL=
AITU_MUSCRIPTOR_DTYPE=
# An engine to load when the server starts, for example muscriptor-large. Natively the default is
# empty (the model loads on the first transcription); compose.yaml sets muscriptor-large. `none`
# turns the preload off.
AITU_PRELOAD_ENGINE=
# Where the backend listens natively (`make serve`). Default 127.0.0.1 and 8765.
# With compose, AITU_PORT is the localhost port the backend is published on.
AITU_HOST=
AITU_PORT=

# The master user's first password, set while it has none (then changed from the user menu).
# Without it, the master user cannot sign in until it is set here and the backend restarts.
AITU_MASTER_PASSWORD=

# --- The inferred popularity (implementation 02, Phase 17; context/music-library/popularity.md) --
# A key of the YouTube Data API v3 (a Google Cloud project with the API turned on). Read by
# `make popularity-collect` and `make popularity-infer` on the host; the app runs without it.
YOUTUBE_API_KEY=
# A Spotify app's client id and secret (developer.spotify.com). Used only to find an artist's
# Spotify id; the streams come from kworb.net (Q-10). Without them, no song gets streams.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Where the answers of those services are kept. Default data/music-library-views beside the
# repository.
MUSIC_LIBRARY_VIEWS_DIR=

# --- Compose only ---------------------------------------------------------------------------------
# Where the page listens on the Ubuntu machine. Default 0.0.0.0: every device of the home network
# opens http://ubuntu:5173 and signs in. 127.0.0.1 keeps it to this machine and the SSH tunnel.
WEB_BIND=
# More host names the page answers to, separated by commas (beside localhost, ubuntu, david-ubuntu).
AITU_ALLOWED_HOSTS=
# The localhost port of the page, which the tunnel from the Mac forwards. Default 5173.
WEB_PORT=
# The host folder mounted as the backend container's home: the ByteDance checkpoint and the torch
# cache. Default /mnt/ssd2/aimpromptu/home.
AITU_CACHE_DIR=
